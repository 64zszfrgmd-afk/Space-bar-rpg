{
  "name": "space-bar-rpg",
  "version": "0.21.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run build && node --test tests/*.test.mjs",
    "test:browser": "node tests/mobile-launch.mjs && node tests/gameplay.mjs && node tests/history-world.mjs && node tests/world-visual.mjs && node tests/user-journey.mjs && node tests/hero-appearance.mjs",
    "test:unit": "vitest run",
    "test:gameplay": "node tests/gameplay.mjs",
    "test:world": "node tests/history-world.mjs",
    "test:hero": "node tests/hero-appearance.mjs",
    "test:visual": "node tests/world-visual.mjs",
    "test:journey": "node tests/user-journey.mjs && node tests/hero-appearance.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
